{
    "name": "@sxo/component-wysiwyg",
    "version": "0.0.1",
    "description": "Headless WYSIWYG Markdown editor component for SXO.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "@milkdown/core": "^7.6.1",
        "@milkdown/preset-commonmark": "^7.6.1",
        "@milkdown/preset-gfm": "^7.6.1",
        "@milkdown/prose": "^7.6.1",
        "@milkdown/transformer": "^7.6.1",
        "@milkdown/theme-nord": "^7.6.1",
        "@milkdown/plugin-listener": "^7.6.1"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.cjs",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "require": "./dist/index.cjs"
            }
        }
    }
}
