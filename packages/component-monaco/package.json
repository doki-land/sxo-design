{
    "name": "@sxo/component-monaco",
    "version": "0.0.1",
    "description": "Headless Monaco Editor component for SXO.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "monaco-editor": "^0.52.2"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    }
}
