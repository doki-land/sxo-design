{
    "private": true,
    "name": "project-sxo",
    "version": "0.0.2",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "author": "sxo team",
    "main": "index.js",
    "dependencies": {
        "vite-plugin-sxo": "link:adaptors/vite-plugin"
    },
    "scripts": {
        "dev": "pnpm -r --parallel --if-present dev",
        "build": "pnpm -r --if-present build",
        "check": "biome check .",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "test": "pnpm -r --if-present test",
        "type-check": "pnpm -r --parallel exec tsc --noEmit",
        "test:coverage": "vitest run --coverage",
        "clean": "npx tsx scripts/clean-dts.ts",
        "fix:syntax": "npx tsx scripts/fix-syntax.ts",
        "find-large-files": "npx tsx scripts/find-large-files.ts",
        "docs:generate": "npx tsx scripts/clean-dts.ts",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "pnpm build && pnpm changeset publish",
        "p": "node scripts/publish.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.11",
        "@changesets/cli": "^2.29.8",
        "@solidjs/testing-library": "^0.8.10",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/node": "^20.19.28",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitejs/plugin-vue2": "^2.3.4",
        "@vitest/coverage-v8": "^3.2.4",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.1.0",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.2.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rolldown": "1.0.0-beta.59",
        "solid-js": "^1.9.10",
        "typescript": "^5.9.3",
        "unplugin-oxc": "^0.5.7",
        "vite": "^7.3.1",
        "vite-plugin-solid": "^2.11.10",
        "vitest": "^3.2.4",
        "vue": "^3.5.26"
    },
    "packageManager": "pnpm@10.27.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/sxo-engine.git"
    },
    "bugs": {
        "url": "https://github.com/doki-land/sxo-engine/issues"
    },
    "homepage": "https://github.com/doki-land/sxo-engine",
    "lint-staged": {
        "*.{ts,tsx,vue,svelte,json,md}": [
            "biome check --write"
        ]
    }
}
